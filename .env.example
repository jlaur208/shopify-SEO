# Copy to .env and fill in. Never commit .env.

# Shopify Admin API, Dev Dashboard app "k2 SEO" (client credentials grant). One store serves all four sites.
KIDS2SHOP_SHOPIFY_URL=https://www.babyeinstein.com
KIDS2SHOP_SHOPIFY_STORE=kids2-babyeinstein
KIDS2SHOP_SHOPIFY_CLIENT_ID=
KIDS2SHOP_SHOPIFY_CLIENT_SECRET=

# Search Console: OAuth client JSON at ./gsc-oauth-client.json, token written by
# `GSC_ACCOUNT=kidsii python3 scripts/gsc.py login` to ./.gsc-token-kidsii.json

# Semrush Site Audit (Kids2 Semrush account): Subscription info, API units, copy the API key
SEMRUSH_API_KEY=
